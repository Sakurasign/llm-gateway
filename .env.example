# =====================================================================
# 复制为 .env 后填入你自己的值：cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交
# =====================================================================

# ── 数据库 ──────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=gateway
# 宿主机映射端口（3306 常被本机 MySQL 占用，默认 13306）
MYSQL_HOST_PORT=13306

# ── RabbitMQ ────────────────────────────────────────────
RABBIT_USER=gateway
RABBIT_PASS=

# ── 管理端凭证（必填，无默认值）─────────────────────────
ADMIN_USERNAME=admin
# 可用明文（启动时自动 BCrypt）或直接填 BCrypt 哈希（$2a$/$2b$ 开头）
ADMIN_PASSWORD=
# 生成方式：openssl rand -hex 32
ADMIN_JWT_SECRET=

# ── 演示用客户端 API Key ────────────────────────────────
# 可选，留空禁用。本地联调用 openssl rand -hex 32 生成。
DEMO_API_KEY=

# ── 端口 ────────────────────────────────────────────────
GATEWAY_PORT=18081

# ── 时区 ────────────────────────────────────────────────
TZ=Asia/Shanghai

# 独立配置加密密钥，首次正式运行前设置（openssl rand -base64 32）
GATEWAY_CONFIG_KEY=
# WorkBuddy 授权账号的定时签到，默认关闭
GATEWAY_WORKBUDDY_CHECKIN=false
